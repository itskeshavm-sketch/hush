# Cloudflare deploy credentials.
#
# Copy this to `.env` and fill in the real values. `.env` is gitignored;
# this example file is not, and must never contain a live token.
#
# Why a file and not `setx`: wrangler runs as a separate process, so an
# environment variable set in your terminal never reaches a deploy run from
# anywhere else. A file is the only thing that reliably crosses the boundary.
#
#   copy .env.example .env
#
# Token scopes required — Cloudflare has no separate "Durable Objects"
# permission, because the DO class, its binding and its migration all ship as
# part of the script upload:
#
#   Account | Workers Scripts   | Edit    <- does the actual work
#   Account | Account Settings  | Read
#   User    | Memberships       | Read    <- wrangler calls /memberships
#   User    | User Details      | Read
#
# Rotate these whenever the token is pasted into a chat, a screenshot, a bug
# report or anything else that leaves your machine. Cloudflare's "Roll" button
# on an existing token regenerates the value in place, so nothing else needs
# editing.

CLOUDFLARE_API_TOKEN=replace_me
CLOUDFLARE_ACCOUNT_ID=0b1168da65671ef505b39502acd93b20

# Operator bearer key for POST /admin/evict (disconnect everyone, clear the
# roster globally). NOT stored here and never committed: set it once with
# `wrangler secret put ADMIN_KEY` (paste the value at the prompt) and keep a
# copy somewhere safe. Anyone holding it can empty the public relay.
# ADMIN_KEY lives in Cloudflare, not in this file.
