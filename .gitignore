# Signing material — never commit a keystore or its passwords
keystore.properties
*.jks
*.keystore

# Relay TLS material. A self-signed relay key is a secret: anyone holding it
# plus the certificate can impersonate the relay to a client that has not
# pinned yet.
server/certs/
*.pem
*.key
*.crt
*.p12

