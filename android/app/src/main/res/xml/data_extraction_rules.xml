<?xml version="1.0" encoding="utf-8"?>
<!--
  HUSH holds identity keys and message history. None of it belongs in a cloud
  backup or a device-to-device transfer: restoring an identity key onto a second
  device would give two live peers with the same key, which the relay resolves
  by evicting one of them mid-conversation.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>